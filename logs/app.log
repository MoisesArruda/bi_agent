WITH top_countries AS (
    SELECT country, COUNT(*) AS total_movies
    FROM netflix.netflix
    WHERE type = 'Movie' AND country IS NOT NULL
    GROUP BY country
    ORDER BY total_movies DESC
    LIMIT 10
),
country_year_counts AS (
    SELECT country, release_year, COUNT(*) AS year_count
    FROM netflix.netflix
    WHERE type = 'Movie' AND country IS NOT NULL
    GROUP BY country, release_year
)
SELECT 
    tc.country, 
    tc.total_movies, 
    cyc.release_year AS year_most_movies, 
    cyc.year_count AS movies_in_that_year
FROM top_countries tc
JOIN country_year_counts cyc ON tc.country = cyc.country
JOIN (
    SELECT country, MAX(year_count) AS max_year_count
    FROM country_year_counts
    GROUP BY country
) max_cyc ON cyc.country = max_cyc.country AND cyc.year_count = max_cyc.max_year_count
ORDER BY tc.total_movies DESC, tc.country;
